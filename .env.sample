# Скопируйте этот файл в .env и подставьте свои значения
SECRET_KEY=your-secret-key
DEBUG=True

POSTGRES_DB=skystore_users_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Почта. Чтобы письма печатались в терминал, ничего не меняйте.
# Чтобы письма уходили по-настоящему (например, через Яндекс):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST_USER=ваш_адрес@yandex.ru
#   EMAIL_HOST_PASSWORD=пароль_приложения (создаётся в настройках Яндекс ID)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
